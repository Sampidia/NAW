<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <!-- Received Message (Left-aligned) -->
    <TextView
        android:id="@+id/receivedMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="280dp"
        android:background="@drawable/chat_message_received_background"
        android:textColor="#4d311e"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- Sent Message (Right-aligned) -->
    <TextView
        android:id="@+id/sentMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:maxWidth="280dp"
        android:background="@drawable/chat_message_sent_background"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- Game Invite Card (Right-aligned - from sender) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gameInviteCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="60dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/inviteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4d311e"
                android:textSize="14sp"
                android:gravity="center"
                android:maxWidth="220dp" />

            <Button
                android:id="@+id/joinButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="JOIN"
                android:textColor="#4d311e"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingHorizontal="32dp"
                android:background="@drawable/join_button_background" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>