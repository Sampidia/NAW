<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <!-- Received Message (Left-aligned) -->
    <TextView
        android:id="@+id/receivedMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="280dp"
        android:background="@drawable/chat_message_received_background"
        android:textColor="#4d311e"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- Sent Message (Right-aligned) -->
    <TextView
        android:id="@+id/sentMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:maxWidth="280dp"
        android:background="@drawable/chat_message_sent_background"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

</FrameLayout>