<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".GameRoomActivity">

    <!-- Top Bar: Input and Join Button -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/exit_icon"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            app:tint="#5D4037" />

        <EditText
            android:id="@+id/searchRoomInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Enter Room ID"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_edit_text_outline"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/searchJoinButton"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="JOIN ROOM"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Action Buttons: Create Lobby -->
    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <Button
            android:id="@+id/createRoomButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CREATE LOBBY"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Room List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        app:layout_constraintTop_toBottomOf="@id/actionButtonsLayout"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
