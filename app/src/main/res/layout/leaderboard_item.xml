<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Rank Circle -->
        <TextView
            android:id="@+id/rankTextView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/circle_rank_background"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Avatar -->
        <ImageView
            android:id="@+id/avatarImageView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/rankTextView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scaleType="centerCrop" />

        <!-- Username -->
        <TextView
            android:id="@+id/usernameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Username"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@+id/avatarImageView"
            app:layout_constraintEnd_toStartOf="@+id/pointsLabel"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Games -->
        <TextView
            android:id="@+id/gamesTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="Games: 0"
            android:textSize="11sp"
            android:textColor="#888888"
            app:layout_constraintStart_toEndOf="@+id/avatarImageView"
            app:layout_constraintTop_toBottomOf="@+id/usernameTextView" />

        <!-- Win Rate -->
        <TextView
            android:id="@+id/winRateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="1dp"
            android:text="Win rate: 0%"
            android:textSize="11sp"
            android:textColor="#888888"
            app:layout_constraintStart_toEndOf="@+id/avatarImageView"
            app:layout_constraintTop_toBottomOf="@+id/gamesTextView" />

        <!-- Points Label -->
        <TextView
            android:id="@+id/pointsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: 0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#333333"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Win/Draw/Lost Badges Row -->
        <LinearLayout
            android:id="@+id/badgesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pointsLabel">

            <!-- Win Badge -->
            <TextView
                android:id="@+id/winBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="Win: 0"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_win_background" />

            <!-- Draw Badge -->
            <TextView
                android:id="@+id/drawBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="Draw: 0"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_draw_background" />

            <!-- Lost Badge -->
            <TextView
                android:id="@+id/lostBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="Lost: 0"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_lost_background" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
